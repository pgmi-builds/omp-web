# The dsh-* packages are peer dependencies supplied by the host profile's
# hoisted node_modules (single copy). Never auto-install them here: a nested
# copy would make the provider resolve dsh-scope/cordis/... to a SECOND
# physical instance at runtime, breaking the harness's scopeOf (cross-copy
# Context reads undefined) and failing web-API session.create with
# "agent-presets: refusing to compose an unscoped context".
auto-install-peers=false
