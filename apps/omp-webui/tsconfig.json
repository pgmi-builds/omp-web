      "@deepseek-ai/dsh-scope": ["./types/@deepseek-ai/dsh-scope/index.d.ts"],
      "@deepseek-ai/dsh-session": ["./types/@deepseek-ai/dsh-session/index.d.ts"],
      "@deepseek-ai/dsh-session/types": ["./types/@deepseek-ai/dsh-session/types.d.ts"],
