{
  "name": "@pgmi-builds/omp-web-sdk",
  "version": "0.0.1-alpha.1",
  "description": "OMP Web SDK line: same dsh bridging contract as omp-web, but the OMP core is embedded via the @oh-my-pi/pi-coding-agent SDK (Bun sidecar) instead of `omp --mode rpc`.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0",
    "bun": "^1.3.14"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
